{
  "name": "lifeos-local",
  "version": "0.1.0",
  "description": "Local-first 3D personal growth system with Markdown notes and private AI conversation.",
  "homepage": "https://github.com/okeya24/lifeos-local-showcase",
  "repository": {
    "type": "git",
    "url": "https://github.com/okeya24/lifeos-local-showcase.git"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite --host 127.0.0.1 --port 5173\" \"node --watch server/index.mjs\"",
    "dev:web": "vite --host 127.0.0.1 --port 5173",
    "dev:api": "node --watch server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.mjs",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.0",
    "express": "^5.1.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
